tags: BigQuery
stages:
  Inputs:
    actors:
      Interface:
        parent: Const
        in:
          value:
            const: null
            external: sourceInterface
            schema: string
        out:
          value:
            schema: string
      Schema:
        parent: Const
        in:
          value:
            const: null
            external: sourceSchema
            schema: string
        out:
          value:
            schema: string
      Table:
        parent: Const
        in:
          value:
            const: null
            external: sourceTableName
            schema: string
        out:
          value:
            schema: string
      Params:
        parent: Const
        in:
          value:
            const: null
            external: filterParametersInfo
        out:
          value:
            schema: '#ref'
      FilterGUI:
        parent: Const
        in:
          value:
            const: null
            external: filterGUI
        out:
          value:
            schema: '#ref'
      Where Claוse:
        parent: Const
        remark: The Where Cluase created based on the parameters when the task was
          created/edited.
        in:
          value:
            const: null
            external: whereClause
            schema: string
        out:
          value:
            schema: string
  Get Table Schema:
    actors:
      FetchColumnsTypes:
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface/value
          sql:
            const: |-
              SELECT
                column_name,
                data_type
              FROM
                `$projectId.${@dataset}.INFORMATION_SCHEMA.COLUMNS`
              WHERE table_name = ${table}
          table:
            link: Table/value
            schema: string
            mandatory: false
          dataset:
            link: Schema/value
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Build typed params array:
    actors:
      ParseParamsValues:
        parent: InnerFlow
        in:
          flowName:
            const: BQParseQueryParams
          tableSchema:
            link: FetchColumnsTypes/result
            schema: '#ref'
            mandatory: false
          params:
            link: Params/value
            schema: '#ref'
            mandatory: false
        out:
          parsedParamsValues:
            schema: '#ref'
  Build Count statement:
    actors:
      BuildCountStatement:
        parent: JavaScript
        height: 226
        in:
          script:
            const: |-
              var statement = "select count(*) from `$projectId." + dataset + "." + table + "`";
              if (where) {
                  statement = statement + " where " + where;
              }
              statement;
          dataset:
            link: Schema/value
            schema: string
            mandatory: false
          table:
            link: Table/value
            schema: string
            mandatory: false
          where:
            link: Where Claוse/value
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Run Count:
    actors:
      DbFetchField1:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: Interface/value
          sql:
            const: null
            link: BuildCountStatement/result
          params:
            link: ParseParamsValues/parsedParamsValues
        out:
          result:
            external: tableCount
schemas:
  Params.out.value:
    type: array
    items:
      type: object
      properties:
        field_name:
          type: string
        field_type:
          type: string
        field_value:
          type: integer
  FilterGUI.out.value:
    type: array
    items:
      type: string
  FetchColumnsTypes.out.result:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        data_type:
          type: string
  ParseParamsValues.in.tableSchema:
    type: array
    items: {
      }
  ParseParamsValues.in.params:
    type: array
    items: {
      }
  ParseParamsValues.out.parsedParamsValues:
    type: array
    items:
      type: string
